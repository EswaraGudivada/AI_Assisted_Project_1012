<Project>
  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<LangVersion>latest</LangVersion>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	<EnableNETAnalyzers>true</EnableNETAnalyzers>
	<AnalysisLevel>latest</AnalysisLevel>
	<!-- Note: Some vulnerabilities in dependencies are acceptable for this prototype -->
	<!-- In production, monitor https://github.com/advisories/GHSA-2m69-gcr7-jv3q and GHSA-{...} for SQLite and System.Security.Cryptography.Xml -->
	<NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
</Project>
